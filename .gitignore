# Local Terraform state and plugin cache
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# Variable files may contain secrets - keep the example only
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Plan output
*.tfplan

# CLI configuration files
.terraformrc
terraform.rc

# Editor / OS files
.vscode/
.idea/
.DS_Store
